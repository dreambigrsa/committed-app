NEXT_PUBLIC_SITE_URL=https://committed.dreambig.org.za

# Same committed API as Expo (`EXPO_PUBLIC_COMMITTED_API_BASE_URL` in app root .env).
# Default in code matches Expo prod: https://committed-5mxf.onrender.com
NEXT_PUBLIC_COMMITTED_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_FUNCTIONS_BASE=https://YOUR_PROJECT_REF.functions.supabase.co/functions/v1
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEEPLINK_SCHEME=committed://
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@dreambig.org.za

# Resend – must use your verified domain (e.g. dreambig.org.za)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Committed <noreply@dreambig.org.za>
